#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "run as root: sudo $0" >&2
	exit 1
fi

target=${1:-$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }')}

if [ -z "$target" ]; then
	echo "no login user found" >&2
	exit 1
fi

home=$(getent passwd "$target" | cut -d: -f6)
repo="$home/dotfiles"
bin="$repo/greeter/bin/greeter"
config="$repo/shell/config.toml"

if [ ! -x "$bin" ]; then
	echo "missing $bin: run xmake greeter as $target first" >&2
	exit 1
fi

chmod o+x "$home"

if ! runuser -u greeter -- test -x "$repo/greeter/start" || ! runuser -u greeter -- test -x "$bin" || ! runuser -u greeter -- test -r "$config"; then
	echo "greeter cannot run $repo/greeter/start with $bin and $config" >&2
	exit 1
fi

setting() {
	sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\{0,1\}\([^\"#]*[^\"#[:space:]]\)\"\{0,1\}.*/\1/p" "$config" | head -1
}

font="$(setting fontFamily):size=$(setting lockFontSize)"

rm -rf /etc/greetd/quickshell /var/lib/quickshell/greeter
rmdir /var/lib/quickshell 2>/dev/null || true
rm -f /etc/greetd/hyprland.lua /etc/greetd/start-greeter
rm -f /etc/sudoers.d/greeter-power /etc/sudoers.d/greeter-logout /usr/local/bin/qs-logout
rm -f /etc/tmpfiles.d/greetd-greeter.conf

usermod -aG video,render,input greeter

install -d -m 755 /etc/polkit-1/rules.d

cat > /etc/polkit-1/rules.d/49-quickshell-greeter.rules <<POLKIT
polkit.addRule(function (action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
		subject.user == "$target" &&
		action.lookup("unit") == "greetd.service" &&
		action.lookup("verb") == "start") {
		return polkit.Result.YES;
	}

	if (subject.user == "greeter" &&
		(action.id == "org.freedesktop.login1.power-off" ||
		 action.id == "org.freedesktop.login1.power-off-multiple-sessions" ||
		 action.id == "org.freedesktop.login1.reboot" ||
		 action.id == "org.freedesktop.login1.reboot-multiple-sessions")) {
		return polkit.Result.YES;
	}
});
POLKIT

chmod 644 /etc/polkit-1/rules.d/49-quickshell-greeter.rules

[ -f /etc/security/faillock.conf.bak ] || cp -a /etc/security/faillock.conf /etc/security/faillock.conf.bak

cat > /etc/security/faillock.conf <<'FAILLOCK'
deny = 3
unlock_time = 3
FAILLOCK

install -d -m 755 /etc/greetd
[ -f /etc/greetd/config.toml.bak ] || cp -a /etc/greetd/config.toml /etc/greetd/config.toml.bak

cat > /etc/sysctl.d/60-greeter-quiet.conf <<QUIET
kernel.printk = 1 4 1 7
QUIET

sysctl -q -p /etc/sysctl.d/60-greeter-quiet.conf || true

cat > /etc/greetd/config.toml <<CFG
[terminal]
vt = 1
switch = false

[default_session]
command = "$repo/greeter/start 'font=$font' $target $config"
user = "greeter"
CFG

faillock --user "$target" --reset >/dev/null 2>&1 || true

systemctl disable sddm >/dev/null 2>&1 || true
systemctl enable greetd >/dev/null

echo "greeter installed for $target"
echo "font: $font"
echo "your current session is untouched; reboot to test."
echo "rollback: sudo $(dirname "$0")/greeter-uninstall"
