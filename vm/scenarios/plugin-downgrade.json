{
  "context": {
    "cores": 2,
    "mem": 4096,
    "gl": true
  },
  "steps": [
    {
      "do": "wait",
      "until": "guest",
      "timeout": 60000
    },
    {
      "do": "wait",
      "until": "exec:pgrep -x yudaemond",
      "timeout": 60000
    },
    {
      "do": "wait",
      "until": "exec:pgrep -x quickshell",
      "timeout": 60000
    },
    {
      "do": "exec",
      "cmd": "mkdir -p /home/user/.local/share/yudae/plugins && cp -r /home/user/dotfiles/templates/_template-hypr /home/user/.local/share/yudae/plugins/ && mkdir -p /home/user/.local/state/yudae && printf 'load = [\"_template-hypr\"]\\n' > /home/user/.local/state/yudae/plugins.toml",
      "code": 0
    },
    {
      "do": "exec",
      "cmd": "/home/user/dotfiles/build/bin/yudaemond plugin reload",
      "code": 0
    },
    {
      "do": "wait",
      "until": "exec:test -f /home/user/.local/state/yudae/build/_template-hypr/stamp",
      "timeout": 30000
    },
    {
      "do": "exec",
      "cmd": "head -1 /home/user/.local/state/yudae/build/_template-hypr/stamp > /tmp/version-old",
      "code": 0
    },
    {
      "do": "exec",
      "cmd": "sudo cp -n /etc/pacman.conf /etc/pacman.conf.host && printf \"[options]\\nArchitecture = auto\\nSigLevel = Required DatabaseOptional\\nDisableDownloadTimeout\\nCacheDir = /mnt/hostpkg/\\nCacheDir = /var/cache/pacman/pkg/\\n[extra]\\nServer = https://archive.archlinux.org/repos/2026/10/28/\\$repo/os/\\$arch\\n\" | sudo tee /etc/pacman.conf >/dev/null && sudo pacman -Syy --noconfirm >/dev/null && sudo pacman -Sdd --noconfirm --overwrite \"*\" hyprland 2>&1 | tail -5",
      "timeout": 900000
    },
    {
      "do": "exec",
      "cmd": "/home/user/dotfiles/build/bin/yudaemond plugin reload",
      "code": 0
    },
    {
      "do": "wait",
      "until": "exec:head -1 /home/user/.local/state/yudae/build/_template-hypr/stamp | grep -qx \"$(pkg-config --modversion hyprland)\" && ! grep -qx \"$(cat /tmp/version-old)\" /home/user/.local/state/yudae/build/_template-hypr/stamp",
      "timeout": 30000
    },
    {
      "do": "exec",
      "cmd": "head -1 /home/user/.local/state/yudae/build/_template-hypr/stamp | grep -q 0.56.2",
      "code": 0
    }
  ],
  "proof": "a Hyprland downgrade gives the old stamp a miss and rebuilds the plugin"
}
