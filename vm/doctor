#!/usr/bin/env bash
set -u

json=0
for arg in "$@"; do
	[ "$arg" = "--json" ] && json=1
done

fail=0
warn=0
rows=()

row() {
	rows+=("$1|$2|$3|$4")
	case "$2" in
		fail) fail=$((fail + 1)) ;;
		warn) warn=$((warn + 1)) ;;
	esac
}

have() { command -v "$1" >/dev/null 2>&1; }

gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
bar1=$(nvidia-smi -q 2>/dev/null | awk -F: '/BAR1 Memory Usage/ {bar=1} bar && /Total/ {gsub(/^ +| MiB$/, "", $2); print $2; exit}')
prefix=${CONDUIT_PREFIX:-/opt/conduit}
qemu=$prefix/bin/qemu-system-x86_64
backend=$prefix/bin/conduit-backend
viewer=$prefix/bin/conduit-viewer
userspace=$prefix/bin/conduit-userspace
supported=$prefix/share/conduit/supported-drivers.txt
golden=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/vm/golden.qcow2
lock=$HOME/dotfiles/vm/packages.lock

if [ -n "$gpu" ]; then
	row gpu ok "$gpu" ""
else
	row gpu fail "no NVIDIA GPU" "use the GL backend"
fi

if [ -n "$driver" ]; then
	if [ -f "$supported" ] && grep -qxF "$driver" "$supported"; then
		row driver ok "$driver" ""
	elif [ -f "$supported" ]; then
		row driver fail "$driver has no ABI table" "run xmake vm abi, then rebuild conduit-backend"
	else
		row driver warn "$driver, Conduit not installed" "install Conduit and generate its ABI tables"
	fi
else
	row driver warn "not detected" ""
fi

if [ -x "$HOME/qemu-linux/install/bin/qemu-system-x86_64" ]; then
	row qemu.fork ok "$HOME/qemu-linux/install/bin/qemu-system-x86_64" ""
else
	row qemu.fork fail "missing QEMU fork" "build ~/qemu-linux and install it"
fi

for pair in "qemu:$qemu" "backend:$backend" "userspace:$userspace"; do
	name=${pair%%:*}
	path=${pair#*:}
	if [ -x "$path" ]; then
		row "conduit.$name" ok "$path" ""
	else
		row "conduit.$name" fail "missing $path" "install the Conduit package"
	fi
done

if [ -x "$viewer" ]; then
	row conduit.viewer ok "$viewer" ""
else
	row conduit.viewer warn "missing $viewer" "optional: only the external viewer fallback needs it"
fi

if [ -n "${bar1:-}" ]; then
	if [ "$bar1" -lt 1024 ]; then
		row bar1 warn "${bar1}MiB, ReBAR off" "enable ReBAR in BIOS for a larger window; 256MiB works but is slower"
	else
		row bar1 ok "${bar1}MiB" ""
	fi
else
	row bar1 warn "unknown" ""
fi

ovmf=$(find /usr/share/OVMF /usr/share/edk2 /usr/share/ovmf -name 'OVMF_CODE*.fd' 2>/dev/null | head -1)
if [ -n "$ovmf" ]; then
	row ovmf ok "$ovmf" ""
else
	row ovmf warn "no OVMF firmware" "install ovmf; required for the 64-bit GPU BAR"
fi

for path in /dev/kvm /dev/dri/renderD128 /usr/lib/virtiofsd; do
	if [ -e "$path" ]; then
		row "host.$path" ok "$path" ""
	else
		row "host.$path" fail "missing $path" "enable KVM/render node or install virtiofsd"
	fi
done

if [ -f "$golden" ]; then
	if grep -qx 'conduit-guest' "$HOME/dotfiles/vm/packages.txt" 2>/dev/null; then
		row golden ok "$golden" ""
	else
		row golden fail "golden manifest has no conduit-guest" "add conduit-guest to vm/packages.txt and rebuild the golden image"
	fi
else
	row golden fail "no golden image" "run xmake vm golden"
fi

verdict=gl
if [ "$fail" -eq 0 ]; then
	verdict=nvidia
fi

if [ "$json" -eq 1 ]; then
	printf '{"verdict":"%s","gpu":"%s","driver":"%s","fail":%d,"warn":%d,"checks":[' "$verdict" "$gpu" "$driver" "$fail" "$warn"
	first=1
	for item in "${rows[@]}"; do
		IFS='|' read -r name status detail fix <<EOF
$item
EOF
		[ "$first" -eq 0 ] && printf ','
		first=0
		printf '{"name":"%s","status":"%s","detail":"%s","fix":"%s"}' "$name" "$status" "$detail" "$fix"
	done
	printf ']}\n'
	exit 0
fi

for item in "${rows[@]}"; do
	IFS='|' read -r name status detail fix <<EOF
$item
EOF
	printf '%-8s %-4s %-4s %s' "$name" "$status" "" "$detail"
	[ -n "$fix" ] && printf ' | %s' "$fix"
	printf '\n'
done
printf '\nverdict: %s\n' "$verdict"
exit 0
