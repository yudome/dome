#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/vm
IMAGES=$CACHE/images
GOLDEN=$IMAGES/current/golden.qcow2
DURABLE=${DOTFILES_VM_BASE:-${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/vm-image}
RUNS=${DOTFILES_VM_RUNS:-$ROOT/vm/runs}
QEMU_IMG=$(command -v qemu-img)

usage() {
	echo "usage: vm/images build [--snapshot YYYY/MM/DD] [--force]|ensure|overlay <name> [golden-tag]|snapshot <name> <tag>|restore <name> <tag>|backup|list" >&2
	exit 2
}

cmd_ensure() {
	[ -f "$GOLDEN" ] && return
	local saved
	saved=$(find "$DURABLE" -mindepth 2 -maxdepth 2 -name golden.qcow2 -printf '%h\n' 2>/dev/null | sort | tail -1)
	if [ -n "$saved" ]; then
		mkdir -p "$IMAGES"
		cp -a --reflink=auto "$saved" "$IMAGES/"
		ln -sfn "$(basename "$saved")" "$IMAGES/current"
		echo "image restored $IMAGES/current"
		return
	fi
	"$ROOT/vm/mkosi/build"
}

cmd_backup() {
	local src
	src=$(readlink -f "$IMAGES/current") || { echo "no image built" >&2; exit 1; }
	[ -f "$src/golden.qcow2" ] || { echo "no image built" >&2; exit 1; }
	rm -rf "$DURABLE.tmp"
	mkdir -p "$DURABLE.tmp"
	cp -a --reflink=auto "$src" "$DURABLE.tmp/"
	rm -rf "$DURABLE"
	mv "$DURABLE.tmp" "$DURABLE"
	echo "image backup $DURABLE/$(basename "$src")"
}

cmd_overlay() {
	[ $# -ge 1 ] || usage
	local name=$1 base=${2:-} golden
	if [ -n "$base" ] && [ "$base" != current ]; then
		golden=$CACHE/golden-$base.qcow2
		[ -f "$golden" ] || { echo "golden $base not built" >&2; exit 1; }
	else
		cmd_ensure >&2
		golden=$GOLDEN
	fi
	golden=$(readlink -f "$golden")
	mkdir -p "$RUNS/$name"
	rm -f "$RUNS/$name/disk.qcow2"
	"$QEMU_IMG" create -q -f qcow2 -F qcow2 -b "$golden" "$RUNS/$name/disk.qcow2" 32G
	echo "$RUNS/$name/disk.qcow2"
}

cmd_snapshot() {
	[ $# -ge 2 ] || usage
	"$QEMU_IMG" snapshot -c "$2" "$RUNS/$1/disk.qcow2"
	"$QEMU_IMG" snapshot -l "$RUNS/$1/disk.qcow2"
}

cmd_restore() {
	[ $# -ge 2 ] || usage
	"$QEMU_IMG" snapshot -a "$2" "$RUNS/$1/disk.qcow2"
	echo "restored $2"
}

cmd_list() {
	local golden tag
	[ -f "$GOLDEN" ] && echo "golden current"
	for golden in "$CACHE"/golden-*.qcow2; do
		[ -f "$golden" ] || continue
		tag=$(basename "$golden" .qcow2)
		echo "golden ${tag#golden-}"
	done
	find "$RUNS" -maxdepth 2 -name disk.qcow2 -printf '%h\n' 2>/dev/null | xargs -r -n1 basename
}

command=${1:-}
shift || true

case "$command" in
	build|images|packages|golden) exec "$ROOT/vm/mkosi/build" "$@" ;;
	ensure) cmd_ensure ;;
	backup) cmd_backup ;;
	overlay) cmd_overlay "$@" ;;
	snapshot) cmd_snapshot "$@" ;;
	restore) cmd_restore "$@" ;;
	list) cmd_list ;;
	*) usage ;;
esac
